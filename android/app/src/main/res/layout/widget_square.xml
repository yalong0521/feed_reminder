<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">
    <TextView
        android:id="@+id/widget_square_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_square_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_secondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <LinearLayout
        android:id="@+id/widget_square_data"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_square_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_square_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="72dp"
            android:gravity="end"
            android:textColor="@color/widget_secondary"
            android:textSize="12sp"
            android:maxLines="2" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_square_empty_subtitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp"
        android:maxLines="2" />
    <TextView
        android:id="@+id/widget_square_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/widget_secondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_square_action"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:textColor="@color/widget_on_primary"
        android:textSize="12sp" />
</LinearLayout>
