{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "launchType": "singleton",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        // Enable sensor rotation while respecting the system rotation lock.
        "orientation": "auto_rotation_unspecified",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon_layered",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:launch_icon",
        "startWindowBackground": "$color:start_window_background",
        // API 19+ uses the branded launch profile; older systems retain the icon and background above.
        "startWindow": "$profile:start_window",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "FeedReminderFormAbility",
        "srcEntry": "./ets/widgets/FeedReminderFormAbility.ets",
        "type": "form",
        "exported": true,
        "metadata": [
          { "name": "ohos.extension.form", "resource": "$profile:form_config" }
        ]
      }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.VIBRATE" },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER",
        "reason": "$string:reminder_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      }
    ]
  }
}
